# Copy to .env and adjust. Do not commit real secrets.

POSTGRES_DB=yademoon
POSTGRES_USER=yademoon
POSTGRES_PASSWORD=yademoon
POSTGRES_PORT=5432

# ASP.NET Core connection string (matches docker-compose defaults)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=yademoon;Username=yademoon;Password=yademoon

# Configurable product display name
Product__DisplayName=یادمون
Product__Version=0.1.0

# Angular origin for CORS + cookies
Frontend__Origin=http://localhost:4200

# Frontend (also editable in src/environments/environment*.ts)
# VITE-style not used — Angular reads environment.ts
# apiBaseUrl=http://localhost:5080
# productName=یادمون
